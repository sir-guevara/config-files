(defpoll state :interval "3s" `~/.config/eww/scripts/status`)
(defvar panel_reveal true)

(defwidget section-title [text]
  (label :class "section-title" :halign "start" :text text))

(defwidget connect-button [class icon text status command]
  (button :class "connect-button ${class}" :onclick command
    (box :orientation "h" :spacing 11
      (box :class "action-icon-wrap" (label :class "action-icon" :text icon))
      (box :orientation "v" :hexpand true :valign "center"
        (label :class "action-title" :halign "start" :text text)
        (label :class "action-status" :halign "start" :limit-width 18
          :show-truncated true :text status))
      (label :class "action-chevron" :text "›"))))

(defwidget mode-button [class icon text command]
  (button :class "mode-button ${class}" :onclick command
    (box :orientation "v" :spacing 7
      (box :class "action-icon-wrap" :hexpand false :vexpand false
        :halign "center" :valign "center"
        (label :class "action-icon" :halign "center" :valign "center" :text icon))
      (label :class "action-title" :text text))))

(defwidget metric [class icon name value]
  (box :class "metric ${class}" :spacing 9
    (label :class "metric-icon" :text icon)
    (label :hexpand true :halign "start" :text name)
    (label :class "metric-value" :text value)))

(defwidget footer-button [class icon text command]
  (button :class "footer-button ${class}" :onclick command
    (box :orientation "v" :spacing 4
      (label :class "footer-icon" :text icon)
      (label :text text))))

(defwidget quick-settings []
  (box :class "panel" :orientation "v" :space-evenly false
    (box :class "header" :space-evenly false
      (label :class "title" :hexpand true :halign "start" :text "Control Center")
      (label :class "time" :text {state.time}))

    (box :class "action-grid" :homogeneous true :spacing 8
      (mode-button :class {state.wifi_on ? "wifi active" : "wifi"}
        :icon "󰖩" :text "Wi-Fi" :command "~/.config/eww/scripts/control wifi-toggle")
      (mode-button :class {state.bluetooth_on ? "bluetooth active" : "bluetooth"}
        :icon "󰂯" :text "Bluetooth" :command "~/.config/eww/scripts/control bluetooth-toggle")
      (mode-button :class {state.night_on ? "night active" : "night"}
        :icon "󰖔" :text "Night" :command "~/.config/eww/scripts/control night-toggle")
      (mode-button :class {state.dark_on ? "dark active" : "dark"}
        :icon "󰔎" :text "Dark" :command "~/.config/eww/scripts/control dark-toggle"))

    (button :class "device-link" :onclick "~/.config/eww/scripts/open-tool network"
      (box (label :class "network-icon" :text "󰤨")
        (label :hexpand true :halign "start" :limit-width 28 :show-truncated true :text {state.ssid})
        (label :class "muted" :text "Manage  ›")))

    (box :class "slider-row volume-row" :spacing 9
      (button :class "icon-button" :onclick "~/.config/eww/scripts/open-tool sound" (label :text "󰕾"))
      (scale :class "control-scale" :hexpand true :min 0 :max 100
        :value {state.volume} :onchange "~/.config/eww/scripts/control volume {}")
      (label :class "percent" :text "${state.volume}%"))

    (box :class "slider-row brightness-row" :spacing 9
      (label :class "slider-icon" :text "󰃠")
      (scale :class "control-scale" :hexpand true :min 5 :max 100
        :value {state.brightness} :onchange "~/.config/eww/scripts/control brightness {}")
      (label :class "percent" :text "${state.brightness}%"))

    (overlay :class "media-card" :visible {state.playing}
      (image :class "media-backdrop" :visible {state.album_blur != ""}
        :path {state.album_blur} :image-width 414 :image-height 136
        :preserve-aspect-ratio false)
      (box :class "media-content" :spacing 13
        (box :class "album-art" :hexpand false :halign "start" :valign "center"
          (image :visible {state.album_art != ""} :path {state.album_art}
            :image-width 72 :image-height 72 :preserve-aspect-ratio true)
          (label :visible {state.album_art == ""} :text "󰝚"))
        (box :orientation "v" :hexpand true :valign "center" :spacing 2
          (label :class "now-playing-label" :halign "start" :text "NOW PLAYING")
          (label :class "song" :halign "start" :limit-width 25
            :show-truncated true :text {state.song})
          (label :class "artist" :halign "start" :limit-width 25
            :show-truncated true :text {state.artist})
          (box :class "media-controls" :halign "start" :spacing 8
            (button :onclick "playerctl previous" (label :text "󰒮"))
            (button :class "play" :onclick "playerctl play-pause"
              (label :text {state.playing ? "󰏤" : "󰐊"}))
            (button :onclick "playerctl next" (label :text "󰒭"))))))

    (box :class "tools" :homogeneous true :spacing 7
      (button :onclick "~/.config/eww/scripts/open-tool mouse" (label :text "󰍽  Mouse"))
      (button :onclick "~/.config/eww/scripts/open-tool screens" (label :text "󰍹  Displays"))
      (button :onclick "~/.config/eww/scripts/open-tool sound" (label :text "󰕾  Sound")))

    (box :class "footer" :space-evenly true :spacing 6
      (footer-button :class "lock" :icon "󰌾" :text "Lock"
        :command "~/.config/qtile/scripts/lock-screen")
      (footer-button :class "suspend" :icon "󰤄" :text "Suspend"
        :command "systemctl suspend")
      (footer-button :class "restart" :icon "󰜉" :text "Restart"
        :command "systemctl reboot")
      (footer-button :class "power" :icon "󰐥" :text "Power"
        :command "systemctl poweroff"))))

(defwindow quick-settings-panel
  :monitor 0
  :geometry (geometry :x "-24px" :y "66px" :width "450px" :anchor "top right")
  :stacking "fg"
  :exclusive false
  :focusable true
  (revealer
    :reveal panel_reveal
    :transition "slideleft"
    :duration "260ms"
    (quick-settings)))
