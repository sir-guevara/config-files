#!/bin/sh

# Set FreeBSD master volume from an Eww slider value.
# Expected input: a number from 0 to 100.

value="${1%%.*}"

case "$value" in
    ''|*[!0-9]*)
        exit 1
        ;;
esac

if [ "$value" -lt 0 ]; then
    value=0
elif [ "$value" -gt 100 ]; then
    value=100
fi

mixer vol "$value" >/dev/null 2>&1