#!/bin/sh

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]/ /g'
}

time=$(date '+%I:%M %p')
volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d", $2 * 100}')
brightness=$(~/.config/qtile/scripts/brightness get 2>/dev/null)

wifi_on=false
[ "$(nmcli -t -f WIFI general 2>/dev/null)" = enabled ] && wifi_on=true
ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1)
[ -n "$ssid" ] || ssid="Wi-Fi disconnected"

bluetooth_on=false
bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && bluetooth_on=true

night_on=false
[ -f "${XDG_RUNTIME_DIR:-/tmp}/groovy-night-mode" ] && night_on=true
dark_on=$(~/.config/qtile/scripts/theme-mode status 2>/dev/null || printf 'true')

cpu=$(LC_ALL=C top -bn1 2>/dev/null | awk '/Cpu\(s\)/ {printf "%d", 100 - $8; exit}')
ram=$(free -h 2>/dev/null | awk '/^Mem:/ {print $3 " / " $2}')
storage=$(df -h / 2>/dev/null | awk 'NR == 2 {print $3 " / " $2}')
uptime=$(uptime -p 2>/dev/null | sed 's/^up //; s/ days\?/d/; s/ hours\?/h/; s/ minutes\?/m/; s/,//g')
temp=$(awk '{printf "%.0f°C", $1 / 1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
[ -n "$temp" ] || temp="--°C"

artist=$(playerctl metadata --format '{{artist}}' 2>/dev/null)
song=$(playerctl metadata --format '{{title}}' 2>/dev/null)
art_url=$(playerctl metadata --format '{{mpris:artUrl}}' 2>/dev/null)
playing=false
[ "$(playerctl status 2>/dev/null)" = Playing ] && playing=true
[ -n "$artist" ] || artist="Nothing playing"
[ -n "$song" ] || song="Open your music player"

album_art=""
case "$art_url" in
    file://*)
        album_art=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.argv[1][7:]))' "$art_url")
        ;;
    http://*|https://*)
        art_cache="${XDG_CACHE_HOME:-$HOME/.cache}/eww-media"
        mkdir -p "$art_cache"
        art_key=$(printf '%s' "$art_url" | cksum | awk '{print $1}')
        art_file="$art_cache/$art_key"
        art_lock="$art_file.downloading"
        if [ -s "$art_file" ]; then
            album_art=$art_file
        elif mkdir "$art_lock" 2>/dev/null; then
            (
                temp="$art_file.tmp"
                if curl --location --fail --silent --show-error --max-time 10 \
                    "$art_url" --output "$temp"; then
                    mv "$temp" "$art_file"
                else
                    rm -f "$temp"
                fi
                rmdir "$art_lock"
            ) >/dev/null 2>&1 &
        fi
        ;;
esac

printf '{"time":"%s","volume":%s,"brightness":%s,"wifi_on":%s,"ssid":"%s","bluetooth_on":%s,"night_on":%s,"dark_on":%s,"cpu":%s,"temp":"%s","ram":"%s","storage":"%s","uptime":"%s","artist":"%s","song":"%s","album_art":"%s","playing":%s}\n' \
    "$(json_escape "$time")" "${volume:-0}" "${brightness:-50}" "$wifi_on" \
    "$(json_escape "$ssid")" "$bluetooth_on" "$night_on" "$dark_on" "${cpu:-0}" \
    "$(json_escape "$temp")" "$(json_escape "$ram")" "$(json_escape "$storage")" \
    "$(json_escape "$uptime")" "$(json_escape "$artist")" "$(json_escape "$song")" \
    "$(json_escape "$album_art")" "$playing"
