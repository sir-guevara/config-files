def get_wifi_status():
    """Safely extracts the active SSID string array from FreeBSD ifconfig."""
    try:
        output = subprocess.check_output("ifconfig wlan0 | grep 'ssid'", shell=True).decode("utf-8")
        parts = output.split("ssid ")
        if len(parts) > 1:
            return parts[1].split(" ")[0].strip()
        return "Disconnected"
    except Exception:
        return "Disconnected"

def get_battery_status():
    """Queries FreeBSD ACPI layer for live battery status information."""
    try:
        pct = subprocess.check_output("sysctl -n hw.acpi.battery.life", shell=True).decode("utf-8").strip()
        state = subprocess.check_output("sysctl -n hw.acpi.battery.state", shell=True).decode("utf-8").strip()
        
        icon = ""
        if state == "2":
            icon = "  "  # Restored charging bolt icon
        elif int(pct) < 20:
            icon = ""  # Critical low warning icon
            
        return f"{icon} {pct}%"
    except Exception:
        return "   N/A"

def get_volume_status():
    """Queries FreeBSD mixer utility to extract master volume metrics."""
    try:
        output = subprocess.check_output("mixer vol", shell=True).decode("utf-8").strip()
        if "mute" in output or "0.00" in output:
            return "   Muted"
        val = output.split(":")[-1].strip()
        percentage = int(float(val) * 100)
        return f" {percentage}%"
    except Exception:
        return " N/A"

