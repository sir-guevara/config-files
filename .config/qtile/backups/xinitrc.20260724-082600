#!/bin/sh

dhclient wlan0 

#set display
xrandr --output eDP-1 --mode 2160x1350


# set keyboard repeat rate
xset r rate 300 50

# set wallpaper 
feh --bg--fill ~/wallpapers/wall1.jpg &

#start notification demon
dunst &

# start compositor 
picom &

# Start clipboard manager
copyq &

# :aunch window manager
exec qtile start -b x11
