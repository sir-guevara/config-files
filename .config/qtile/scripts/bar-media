#!/bin/sh

mode=${1:-title}

# Playerctl's implicit player is often a stale Firefox tab. Prefer a playing
# Cider instance, then any player which is actively playing.
player=""
fallback=""
while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    status=$(playerctl -p "$candidate" status 2>/dev/null)
    case "$candidate:$status" in
        [Cc]ider*:Playing) player=$candidate; break ;;
        *:Playing) [ -n "$player" ] || player=$candidate ;;
        [Cc]ider*:*) [ -n "$fallback" ] || fallback=$candidate ;;
    esac
done <<EOF
$(playerctl -l 2>/dev/null)
EOF

[ -n "$player" ] || player=$fallback
[ -n "$player" ] || exit 0
[ "$(playerctl -p "$player" status 2>/dev/null)" = "Playing" ] || exit 0

art_url=$(playerctl -p "$player" metadata --format '{{mpris:artUrl}}' 2>/dev/null)

if [ "$mode" = title ]; then
    title=$(playerctl -p "$player" metadata --format '{{title}} — {{artist}}' 2>/dev/null)
    [ -n "$title" ] || exit 0
    width=27
    length=$(printf '%s' "$title" | awk '{print length}')
    if [ "$length" -le "$width" ]; then
        printf '%s\n' "$title"
        exit 0
    fi
    step=$(date +%s)
    offset=$((step % (length + 5)))
    printf '%s     %s' "$title" "$title" | awk -v start="$((offset + 1))" -v width="$width" '{print substr($0, start, width)}'
    exit 0
fi

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/qtile-media"
mkdir -p "$cache_dir"
case "$art_url" in
    file://*) source=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.argv[1][7:]))' "$art_url") ;;
    http://*|https://*)
        key=$(printf '%s' "$art_url" | cksum | awk '{print $1}')
        source="$cache_dir/source-$key"
        if [ ! -s "$source" ]; then
            curl -LfsS --max-time 8 "$art_url" -o "$source.tmp" && mv "$source.tmp" "$source"
        fi
        ;;
    *) exit 0 ;;
esac
[ -s "$source" ] || exit 0
key=$(printf '%s' "$art_url" | cksum | awk '{print $1}')
cover="$cache_dir/cover-$key.png"
if [ ! -s "$cover" ]; then
    magick "$source" -thumbnail '34x34^' -gravity center -extent 34x34 \
      \( +clone -alpha transparent -fill white -draw 'roundrectangle 0,0 33,33 7,7' \) \
      -alpha set -compose DstIn -composite "$cover" 2>/dev/null || exit 0
fi
printf '%s\n' "$cover"
