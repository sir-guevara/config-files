#!/bin/sh

# =========================================================
# Bluetooth Menu
# FreeBSD + Qtile + Rofi
# =========================================================

ROFI="rofi -dmenu -i -p Bluetooth"

HCONTROL="$(command -v hccontrol)"
BTMGR="$(command -v btmgmt)"

if [ -z "$HCONTROL" ] && [ -z "$BTMGR" ]; then
    printf '%s\n' \
        "Bluetooth tools not installed." \
        "Install: bluez or net/bluetooth packages." |
        rofi -dmenu -p "Bluetooth"

    exit 1
fi

menu() {

    {
        echo "󰂯  Turn Bluetooth On"
        echo "󰂯  Turn Bluetooth Off"
        echo "󰂯  Scan for Devices"
    } | $ROFI

}

selection="$(menu)"

case "$selection" in

"󰂯  Turn Bluetooth On")
    doas service bluetooth start
    ;;

"󰂯  Turn Bluetooth Off")
    doas service bluetooth stop
    ;;

"󰂯  Scan for Devices")

    if command -v btmgmt >/dev/null 2>&1; then
        btmgmt find 2>/dev/null |
            awk '/dev_found/ {print $2}' |
            sort -u |
            rofi -dmenu -i -p "Devices"

    elif command -v hccontrol >/dev/null 2>&1; then
        hccontrol -n ubt0hci inquiry 2>/dev/null |
            rofi -dmenu -i -p "Devices"
    fi

    ;;

esac