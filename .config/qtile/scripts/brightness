#!/bin/sh
set -eu

device_path=$(find /sys/class/backlight -mindepth 1 -maxdepth 1 -type l | head -1)
[ -n "$device_path" ] || exit 1

device=${device_path##*/}
maximum=$(cat "$device_path/max_brightness")
current=$(cat "$device_path/brightness")
percent=$((current * 100 / maximum))

set_percent() {
    value=${1%%.*}
    [ "$value" -lt 5 ] && value=5
    [ "$value" -gt 100 ] && value=100

    if command -v brightnessctl >/dev/null 2>&1; then
        brightnessctl --device "$device" set "${value}%" >/dev/null
    else
        raw=$((maximum * value / 100))
        busctl call org.freedesktop.login1 \
            /org/freedesktop/login1/session/auto \
            org.freedesktop.login1.Session SetBrightness ssu \
            backlight "$device" "$raw" >/dev/null
    fi

    dunstify -a Settings -r 9102 -u low -h "int:value:$value" \
        -i display-brightness-symbolic "Brightness" "${value}%"
}

case "${1:-}" in
    get) printf '%s\n' "$percent" ;;
    set) set_percent "${2:-}" ;;
    up) set_percent $((percent + 5)) ;;
    down) set_percent $((percent - 5)) ;;
    *) printf 'usage: %s {get|set VALUE|up|down}\n' "$0" >&2; exit 2 ;;
esac
