#!/bin/sh
set -eu

theme="$HOME/.config/rofi/power-menu.rasi"
uptime_text="$(uptime -p 2>/dev/null || printf 'unknown')"
battery_text="$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || printf '?')%"
memory_text="$(free -h | awk '/^Mem:/ { print $3 " / " $2 }')"
status="${uptime_text}     ${battery_text}    󰍛 ${memory_text}"

choice="$(
    printf '%s\n' \
        '  Power off' \
        '󰜉  Reboot' \
        '󰤄  Suspend' \
        '  Lock' \
        '󰗽  Log out' |
        rofi -dmenu -i -p System -mesg "$status" -theme "$theme"
)"

case "$choice" in
    *"Power off") systemctl poweroff ;;
    *Reboot) systemctl reboot ;;
    *Suspend) systemctl suspend ;;
    *Lock) loginctl lock-session ;;
    *"Log out") qtile cmd-obj -o cmd -f shutdown ;;
esac
