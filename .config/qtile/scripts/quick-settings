#!/bin/sh

config_dir="$HOME/.config/eww"

if ! eww --config "$config_dir" ping >/dev/null 2>&1; then
    eww --config "$config_dir" daemon >/dev/null 2>&1

    attempts=0
    while ! eww --config "$config_dir" ping >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        [ "$attempts" -ge 20 ] && exit 1
        sleep 0.05
    done
fi

if eww --config "$config_dir" active-windows | grep -q '^quick-settings-panel:'; then
    eww --config "$config_dir" update panel_reveal=false
    sleep 0.22
    exec eww --config "$config_dir" close quick-settings-panel
fi

eww --config "$config_dir" update panel_reveal=false
eww --config "$config_dir" open quick-settings-panel
sleep 0.04
exec eww --config "$config_dir" update panel_reveal=true
