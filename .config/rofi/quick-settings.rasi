/* Groovy Gruvbox quick settings */

* {
    bg:          #282828;
    surface:     #32302f;
    hover:       #3c3836;
    border:      #504945;
    fg:          #ebdbb2;
    muted:       #a89984;
    accent:      #d79921;
    transparent: #00000000;

    font: "JetBrainsMono Nerd Font 11";
    background-color: @transparent;
    text-color: @fg;
}

window {
    location: northeast;
    anchor: northeast;
    x-offset: -12px;
    y-offset: 42px;
    width: 420px;
    padding: 14px;
    border: 1px;
    border-color: @border;
    border-radius: 4px;
    background-color: @bg;
}

mainbox {
    orientation: vertical;
    spacing: 10px;
    padding: 0px;
    background-color: @bg;
    children: [ message, listview ];
}

message {
    padding: 0px;
    background-color: @transparent;
}

textbox {
    padding: 9px 11px;
    border: 1px;
    border-color: @border;
    border-radius: 4px;
    text-color: @fg;
    background-color: @surface;
}

listview {
    lines: 2;
    columns: 3;
    fixed-height: true;
    fixed-columns: true;
    flow: horizontal;
    cycle: true;
    scrollbar: false;
    spacing: 8px;
    padding: 0px;
    background-color: @transparent;
}

element {
    orientation: vertical;
    spacing: 5px;
    padding: 13px 5px;
    border: 1px;
    border-color: @border;
    border-radius: 4px;
    background-color: @surface;
    text-color: @muted;
}

element selected.normal {
    border-color: @accent;
    background-color: @hover;
    text-color: @accent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    padding: 0px;
    text-color: inherit;
    background-color: @transparent;
}

inputbar,
prompt,
entry,
case-indicator,
num-filtered-rows,
element-icon {
    enabled: false;
}
