#!/usr/bin/env python3
"""Minimal settings and setup utility for the Gruvbox Qtile desktop."""

from __future__ import annotations

import configparser
import json
import re
import shutil
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402


GRUVBOX_CSS = b"""
window {
  background-color: #1d2021;
